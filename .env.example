# Copy this file to .env (which is gitignored) and fill in the values.

# Gmail account that sends the daily "what changed" email
GMAIL_ADDRESS=you@gmail.com

# Where to send the report (can be the same address)
REPORT_TO=you@gmail.com

# Sending uses the Gmail API, which needs a one-off OAuth setup rather than a
# password here: see "Email report" in README.md.
