	partition Changes = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportFolder & "changes.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null]),
				    Selected = Table.SelectColumns(Source, {"series_id", "period_date", "is_complete", "change_period", "change_yoy", "change_3m3m_annualised"}),
				    Filtered = Table.SelectRows(Selected, each [period_date] >= DashboardStart)
				in
				    Filtered

	annotation PBI_ResultType = Table
