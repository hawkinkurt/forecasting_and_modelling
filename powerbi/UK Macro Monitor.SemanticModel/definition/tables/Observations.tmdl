table Observations
	lineageTag: 8074f34d-bc4d-5fad-b8eb-8bb06b4ea45d

	/// Average of the values in context: the value itself for one series and period, the monthly average when daily data are shown by month.
	measure 'Series Value' = AVERAGE ( Observations[value] )
		formatString: 0.0
		lineageTag: 71195906-ea9a-541e-b16c-6ae0bcc52152
	/// Most recent value of the series in context, ignoring date filters.
	measure 'Latest Value' =
			VAR LatestPeriod =
			    CALCULATE ( MAX ( Observations[period_date] ), REMOVEFILTERS ( 'Date' ) )
			RETURN
			    CALCULATE ( [Series Value], Observations[period_date] = LatestPeriod, REMOVEFILTERS ( 'Date' ) )
		formatString: 0.00
		lineageTag: f765b937-c136-5734-b8bc-4accd0889ebd
	measure 'GDP growth q/q (%)' = CALCULATE ( [Series Value], Series[series_id] = "gdp_qoq" )
