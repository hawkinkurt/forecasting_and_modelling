	/// The Bank of England's 2% CPI target, shown only where CPI data exist.
	measure 'Inflation target (%)' = IF ( NOT ISBLANK ( [CPI inflation (%)] ), 2 )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: 70ea379f-6185-555b-878c-78f62e0a5236

	column series_id
		dataType: string
		isHidden
		lineageTag: 3d4c1bdf-37b9-5c6f-84f8-3c9b6f22857c
		summarizeBy: none
		sourceColumn: series_id

		annotation SummarizationSetBy = Automatic

	column period_date
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 7e1d5f2b-106c-58c5-bc4d-9b37970913cf
		summarizeBy: none
		sourceColumn: period_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column value
		dataType: double
		lineageTag: f7967043-5023-532e-bd82-0dfd1a63e745
		summarizeBy: sum
		sourceColumn: value

		annotation SummarizationSetBy = Automatic

	column vintage_date
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 2bd6de04-a4d2-56ab-9d0e-2d54da8e9892
		summarizeBy: none
		sourceColumn: vintage_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Observations = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportFolder & "latest_observations.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null]),
				    Selected = Table.SelectColumns(Source, {"series_id", "period_date", "value", "vintage_date"}),
				    Filtered = Table.SelectRows(Selected, each [period_date] >= DashboardStart)
				in
				    Filtered

	annotation PBI_ResultType = Table
