	partition YieldCurve = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportFolder & "yield_curve.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null]),
				    Selected = Table.SelectColumns(Source, {"period_date", "bank_rate", "sonia", "gilt_5y", "gilt_10y", "gilt_20y", "spread_10y_bank_rate_bp", "slope_10y_5y_bp", "slope_20y_5y_bp"}),
				    Filtered = Table.SelectRows(Selected, each [period_date] >= DashboardStart)
				in
				    Filtered

	annotation PBI_ResultType = Table
