table YieldCurve
	lineageTag: 21b0025c-d0a6-537b-ba8d-762d59c361f8

	measure '10y gilt minus Bank Rate (bp)' = AVERAGE ( YieldCurve[spread_10y_bank_rate_bp] )
		formatString: 0
		displayFolder: Rates
		lineageTag: 5add8a86-79eb-5b8b-97b5-a7d13158e0ff
	measure '10y minus 5y gilt (bp)' = AVERAGE ( YieldCurve[slope_10y_5y_bp] )
		formatString: 0
		displayFolder: Rates
		lineageTag: ba5e7ec1-1381-585f-85e9-9bca5af3fd7a
	measure '20y minus 5y gilt (bp)' = AVERAGE ( YieldCurve[slope_20y_5y_bp] )
		formatString: 0
		displayFolder: Rates
		lineageTag: 03d3cc40-03fe-5c64-858d-fb1c1c218c33

